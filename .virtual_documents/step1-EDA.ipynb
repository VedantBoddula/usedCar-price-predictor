


import pandas as pd


data = pd.read_csv("used_car_price_dataset_extended.csv")


data.head()


data.tail()


data.describe()


print(data.isnull().sum())


corr_matrix = data.corr(numeric_only=True)

print(corr_matrix["price_usd"].sort_values(ascending=False))


data.columns


dataFeatures = data.drop("price_usd", axis=1)


dataLabels = data["price_usd"]


dataFeatures.head()


dataLabels.head()





from sklearn.model_selection import train_test_split

X_train, X_test, y_train, y_test = train_test_split(
    dataFeatures,
    dataLabels,
    test_size=0.2,
    random_state=42
)




# X_train → 80% of the FEATURES
# y_train → 80% of the LABELS

# X_test  → 20% of the FEATURES
# y_test  → 20% of the LABELS

#During Training model.fit(X_train, y_train)

#During testing predictions = model.predict(X_test)



print("X_train shape:", X_train.shape)
print("X_test shape:", X_test.shape)



print("y_train shape:", y_train.shape)
print("y_test shape:", y_test.shape)


num_attributes = X_train.select_dtypes(include=["int64","float64"]).columns.tolist()


cat_attributes = X_train.select_dtypes(include=["object"]).columns.tolist()


num_attributes


cat_attributes





from sklearn.pipeline import Pipeline
from sklearn.impute import SimpleImputer
from sklearn.preprocessing import StandardScaler, OneHotEncoder
from sklearn.compose import ColumnTransformer


num_pipeline = Pipeline([
    ("imputer", SimpleImputer(strategy="median")),
    ("standard_scaler", StandardScaler())
])

print(num_pipeline)


cat_pipeline = Pipeline([
    ("imputer", SimpleImputer(strategy="most_frequent")),
    ("one_hot_encoder", OneHotEncoder(handle_unknown="ignore"))
])

print(cat_pipeline)





full_pipeline = ColumnTransformer([
    ("num",num_pipeline, num_attributes),
    ("cat",cat_pipeline, cat_attributes)
])
print(full_pipeline)





data_prepared = full_pipeline.fit_transform(X_train)

print(data_prepared.shape)
print(data_prepared)





from sklearn.linear_model import LinearRegression
from sklearn.model_selection import cross_val_score

lin_reg = LinearRegression()

lin_rmse = -cross_val_score(
    lin_reg,
    data_prepared,
    y_train,
    scoring="neg_root_mean_squared_error",
    cv=10
)

print("Linear Regression RMSE:")
print(pd.Series(lin_rmse).describe())


from sklearn.tree import DecisionTreeRegressor

tree_reg = DecisionTreeRegressor(random_state=42)
tree_rmse = -cross_val_score(
    tree_reg,
    data_prepared,
    y_train,
    scoring="neg_root_mean_squared_error",
    cv=10
)

print("Decision Tree RMSE:")
print(pd.Series(tree_rmse).describe())


from sklearn.ensemble import RandomForestRegressor

forest_reg = RandomForestRegressor(random_state=42)
forest_rmse = -cross_val_score(
    forest_reg,
    data_prepared,
    y_train,
    scoring="neg_root_mean_squared_error",
    cv=10
)

print("Random Forest RMSE:")
print(pd.Series(forest_rmse).describe())





lin_reg.fit(data_prepared, y_train)

print("Linear Regression trained on the full training set.")


X_test_prepared = full_pipeline.transform(X_test)

print(X_test_prepared.shape)


predictions = lin_reg.predict(X_test_prepared)

print(predictions[:10])


from sklearn.metrics import root_mean_squared_error

test_rmse = root_mean_squared_error(y_test, predictions)

print("Final Test RMSE:", test_rmse)



